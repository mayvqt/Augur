# Copy to .env for Docker Compose. Never commit the populated .env file.
AUGUR_DISCORD_TOKEN=
# Use the URL Augur can reach. The Compose file starts Augur only; replace this
# with your Seerr host (for example http://192.168.1.20:5055).
AUGUR_SEERR_BASE_URL=http://YOUR-SEERR-HOST:5055
AUGUR_SEERR_PUBLIC_URL=https://seerr.example.com
AUGUR_SEERR_API_KEY=
